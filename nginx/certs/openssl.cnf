[req]
default_bits       = 2048
prompt             = no
default_md         = sha256
distinguished_name = dn
x509_extensions    = v3_req

[dn]
C  = VN
ST = Kien Giang
L  = Ha Tien
O  = VICEM Ha Tien
CN = 172.16.7.246

[v3_req]
subjectAltName = @alt_names

[alt_names]
IP.1 = 172.16.7.246
IP.2 = 127.0.0.1
DNS.1 = localhost
