# ==== Cấu hình cho Docker (sao chép thành .env.docker rồi điền giá trị thật) ====
# Cổng public trên host (mặc định 4000 nếu bỏ trống)
APP_PORT=4000

# ---- PostgreSQL (DB vicem_cms chạy NGOÀI container) ----
# Trên Docker Desktop (Windows/Mac): dùng host.docker.internal để trỏ về Postgres của host.
# Trên Linux hoặc DB ở máy khác: thay bằng IP/hostname thật của máy chủ DB.
PGHOST=host.docker.internal
PGPORT=5432
PGUSER=vicem_admin
PGPASSWORD=thay_bang_mat_khau_that
PGDATABASE=vicem_cms
PGSCHEMA=atld

# ---- JWT (BẮT BUỘC đổi secret khi lên production) ----
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_va_bi_mat
JWT_EXPIRES=8h

# ---- Server ----
NODE_ENV=production
PORT=4000
# Cùng origin nên trỏ về domain/cổng thật mà người dùng truy cập
CORS_ORIGIN=http://localhost:4000

# ---- AI "Tạo nội dung bằng AI" (kết nối qua LLM Gateway) ----
# Trỏ endpoint về gateway thay vì api.anthropic.com
ANTHROPIC_BASE_URL=https://api.shopaikey.com
# Token của gateway — gửi qua header Authorization: Bearer
ANTHROPIC_AUTH_TOKEN=sk-your-token-here
# (Tùy chọn) Model mặc định nếu muốn khác claude-opus-4-8
# ANTHROPIC_MODEL=claude-opus-4-8
# Lưu ý: khi đã có ANTHROPIC_AUTH_TOKEN thì KHÔNG cần ANTHROPIC_API_KEY.

# ---- Tạo video tự động (auto-video-gen + TTS) ----
# Provider TTS: "vbee" | "elevenlabs" | "lucylab"
TTS_PROVIDER=vbee

# Vbee TTS (khi TTS_PROVIDER=vbee)
VBEE_APP_ID=your_vbee_app_id
VBEE_ACCESS_TOKEN=your_vbee_access_token
# Giọng đọc (tùy chọn — mặc định giọng nam Hà Nội)
VBEE_VOICE_CODE=n_hanoi_male_protrainer_education_vc
VBEE_SPEED_RATE=1.0

# ElevenLabs TTS (khi TTS_PROVIDER=elevenlabs)
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# LucyLab TTS (khi TTS_PROVIDER=lucylab)
# VIETNAMESE_API_KEY=sk_live_...
# VIETNAMESE_VOICEID=your_voice_id_here

# Style video: "dark-neon" | "light-pro"
VIDEO_THEME=dark-neon

# TikTok follow card (hiển thị cuối video)
TIKTOK_DISPLAY_NAME=VICEM Hà Tiên
TIKTOK_HANDLE=@vicemhatien
TIKTOK_FOLLOWERS=

# Số luồng TTS đồng thời (1 cho Vbee/LucyLab; có thể tăng với ElevenLabs)
TTS_CONCURRENCY=1

# ---- OAuth2 / OpenID Connect (đăng nhập xã hội) ----
# Đăng nhập Microsoft (Azure AD — hỗ trợ tài khoản cá nhân + công ty)
# Đăng ký tại: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
# Redirect URI: https://<domain>/api/auth/oauth/microsoft/callback
# MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MICROSOFT_CLIENT_SECRET=your_client_secret
# MICROSOFT_TENANT=common   # Dùng tenant ID nếu chỉ cho tài khoản tổ chức

# Đăng nhập Google / Gmail
# Đăng ký tại: https://console.cloud.google.com/apis/credentials
# Redirect URI: https://<domain>/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxx
